diff --git a/core/core.h b/core/core.h
index c6cc7d6..de9a42a 100755
--- a/core/core.h
+++ b/core/core.h
@@ -66,9 +66,10 @@ typedef enum
 } MCU_REGIST;
 
 typedef enum {
-	HOST_SHUTDOWN = 1,
+	HOST_SHUTDOWN = 1,   /* written at BOOT time: "this power cycle is not a reboot" */
 	HOST_FULL_RESET = 2,
-	HOST_DELAY_POWERON = 3
+	HOST_DELAY_POWERON = 3,
+	HOST_POWEROFF_NOW = 4   /* the host is cutting its own power right now (led blackout) */
 } HOST_PM_MODE;
 
 typedef union {
diff --git a/function/inc/led.h b/function/inc/led.h
index 6b17fff..976d6f5 100644
--- a/function/inc/led.h
+++ b/function/inc/led.h
@@ -31,6 +31,8 @@ void RGB_SendData(uint32_t data);   /* send one 24bit GRB frame */
 void RGB_Reset(uint32_t hi, uint32_t lo);   /* reset/latch pulse after a frame */
 void Timer1_Init(void);
 void RGB_SetMode(led_mode_t mode);
+void RGB_HostOff(void);     /* host shut down : black the strip out */
+void RGB_HostOn(void);      /* host powering up : display allowed */
 void init_led_colors(void);
 void set_color(uint32_t value);
